name: WebdriverIO E2E Multi-Browser Tests - GROUP TST

on:
  push:
    branches: [ main, master, luke-tst]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  e2e-matrix-group-tst:
    name: Test on ${{ matrix.browser }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        browser: [chrome, firefox]

    steps:
      - name: Checkout repository code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Install dependencies
        run: npm install

      - name: Run WebdriverIO Tests
        run: npx wdio run wdio.conf.js --browser ${{ matrix.browser }}
        env:
          CI: true
          BASE_URL: ${{ secrets.BASE_URL }}
          ADMIN_USERNAME: ${{ secrets.ADMIN_USERNAME }}
          ADMIN_PASSWORD: ${{ secrets.ADMIN_PASSWORD }}

      # Bước upload screenshot - Chỉ upload khi test FAIL và bỏ qua warning nếu không có ảnh
      - name: Upload Error Screenshots
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: error-screenshots-${{ matrix.browser }}
          path: screenshots/                   # Đảm bảo folder này trùng với folder lưu ảnh trong wdio.conf.js
          if-no-files-found: ignore             # 👈 Dòng này sẽ làm sạch warning khi không có ảnh lỗi
          retention-days: 7

      # Upload Allure results - Bỏ qua warning nếu không tìm thấy kết quả allure
      - name: Upload Allure results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: allure-results-${{ matrix.browser }}
          path: allure-results/
          if-no-files-found: ignore             # 👈 Thêm để tránh warning tương tự cho Allure
          retention-days: 7